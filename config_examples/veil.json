    "minerTimeout": 300,
    "sslCert": "/etc/letsencrypt/live/pool.example.com/fullchain.pem",
    "sslKey": "/etc/letsencrypt/live/pool.example.com/privkey.pem",
    "sslCA": "./chain.pem",
    "ports": [
      {
        "port": 4333,
        "desc": "Veil stratum (plain TCP, difficulty adjusts to your hashrate)"
      },
      {
        "port": 4334,
        "desc": "Veil stratum over TLS (encrypted)",
        "tls": true
      },
      {
        "port": 4443,
        "desc": "Veil stratum over TLS (alternative port)",
        "tls": true
      },
      {
        "port": 5443,
        "desc": "Veil stratum over TLS (alternative port)",
        "tls": true
      },
      {
        "port": 9443,
        "desc": "Veil stratum over TLS (alternative port)",
        "tls": true
      }
    ],
    "banning": {
      "enabled": true,
      "time": 600,
      "invalidPercent": 25,
      "checkThreshold": 30
    },
    "slushMining": {
      "enabled": true,
      "weight": 86400

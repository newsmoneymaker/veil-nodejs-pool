[Unit]
Description=Veil pool: payment processor (sendmany from the pool wallet; emergency brake: deployment/pause-payments.sh)
After=veil-pool-redis.service veil-node.service
Requires=veil-pool-redis.service
[Service]
Type=simple
User=veilpool
WorkingDirectory=/opt/veil-nodejs-pool
ExecStart=/usr/bin/node /opt/veil-nodejs-pool/init.js -module=payments
Restart=always
RestartSec=15
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

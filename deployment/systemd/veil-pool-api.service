[Unit]
Description=Veil pool: public API (127.0.0.1:8118)
After=veil-pool-redis.service veil-node.service
Requires=veil-pool-redis.service
[Service]
Type=simple
User=veilpool
WorkingDirectory=/opt/veil-nodejs-pool
ExecStart=/usr/bin/node /opt/veil-nodejs-pool/init.js -module=api
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

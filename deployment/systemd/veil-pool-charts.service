[Unit]
Description=Veil pool: charts data collector (hash rate, difficulty, miners, workers on the home page)
After=veil-pool-redis.service veil-pool-api.service
Requires=veil-pool-redis.service
[Service]
Type=simple
User=veilpool
WorkingDirectory=/opt/veil-nodejs-pool
ExecStart=/usr/bin/node /opt/veil-nodejs-pool/init.js -module=chartsDataCollector
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

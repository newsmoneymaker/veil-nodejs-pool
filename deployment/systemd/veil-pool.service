[Unit]
Description=Veil pool: stratum server (miners, share checking with the veilhash helper, block submission)
After=veil-pool-redis.service veil-node.service
Requires=veil-pool-redis.service
[Service]
Type=simple
User=veilpool
WorkingDirectory=/opt/veil-nodejs-pool
ExecStart=/usr/bin/node /opt/veil-nodejs-pool/init.js -module=pool
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
# ports below 1024 need this:
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
